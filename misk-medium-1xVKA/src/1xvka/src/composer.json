{
    "name": "1xvka/app",
    "require": {
        "php": ">=8.2",
        "ext-gmp": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-sodium": "*",
        "web-auth/webauthn-framework": "5.2.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
        
    }
}

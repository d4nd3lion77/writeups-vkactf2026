[Version]
Signature="$WINDOWS NT$"
Class=Sample
ClassGuid={78A1C341-4539-11d3-B88D-00C04FAD5171}
Provider=%ManufacturerName%
DriverVer=06/04/2026,1.0.0.0
CatalogFile=VStorCache.cat

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%VStorCache.DeviceDesc%=VStorCache_Device, Root\VStorCache

[VStorCache_Device.NT]
CopyFiles=Drivers_Dir

[Drivers_Dir]
VStorCache.sys

[VStorCache_Device.NT.Services]
AddService=VStorCache,0x00000002,VStorCache_Service

[VStorCache_Service]
DisplayName=%VStorCache.SVCDESC%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\VStorCache.sys

[Strings]
ManufacturerName="VKACTF"
VStorCache.DeviceDesc="Virtual storage cache device"
VStorCache.SVCDESC="Virtual Storage Cache"

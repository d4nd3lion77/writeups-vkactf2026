000245,000018: 
000246,000019:                                                                                          	# Filename:     VariablesAndConstants.agc
000247,000020:                                                                                          	# Purpose:      Definitions of constants and variables for the validation
000248,000021:                                                                                          	#               suite.
000249,000022:                                                                                          	# Mod history:  07/04/04 RSB.   Began.
000250,000023:                                                                                          	#               07/06/04 RSB.   Added stuff for the MASK test, and the 
000251,000024:                                                                                          	#                               similar logical tests for ROR, WOR, RAND,
000252,000025:                                                                                          	#                               WAND, and RXOR.
000253,000026:                                                                                          	#               07/07/04 RSB.   Addes SKEEP1 through SKEEP7.
000254,000027:                                                                                          	#               11/12/16 MAS.   Added TIME1-TIME6 and NEWJOB.
000255,000028: 

{
  "name": "Green Hacker Theme",
  "type": "dark",
  "colors": {
    "editor.background": "#020d02",
    "editor.foreground": "#00ff66",
    "editorCursor.foreground": "#39ff14",
    "editor.lineHighlightBackground": "#0b2b0b",
    "editor.selectionBackground": "#145214",
    "activityBar.background": "#031403",
    "sideBar.background": "#041a04",
    "statusBar.background": "#063b06",
    "titleBar.activeBackground": "#031403"
  },
  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#228b22",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["keyword", "storage"],
      "settings": {
        "foreground": "#39ff14"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#7cff7c"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#00ffaa"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#00ffcc"
      }
    },
    {
      "scope": ["variable"],
      "settings": {
        "foreground": "#b6ffb6"
      }
    }
  ]
}